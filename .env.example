# ==========================================================
# CYCLOPATH AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
DEMO_MODE=true
# Allows the UI to switch synthetic personas; never enable this for operational deployments.
ENABLE_DEMO_AUTH=true
AUTH_DEMO_ADMIN_PASSWORD=
AUTH_DEMO_MUNICIPAL_PASSWORD=
AUTH_DEMO_RESPONDER_PASSWORD=
AUTH_DEMO_CITIZEN_PASSWORD=

# Google Cloud Platform Configuration
GOOGLE_CLOUD_PROJECT=cyclopath-ai-project
GOOGLE_CLOUD_REGION=asia-south1
STORAGE_BUCKET=cyclopath-disaster-imagery
BIGQUERY_DATASET=cyclopath_analytics
PUBSUB_TOPIC=cyclone-telemetry-feed

# Google AI / Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (PostgreSQL / Cloud SQL)
DATABASE_URL=sqlite:///./cyclopath.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://cyclopath_user:password@localhost:5432/cyclopath_db

# Security & Authentication
# Generate a unique random secret (at least 32 bytes) and store it in Secret Manager for deployment.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Risk Engine Configurable Weights (Default Sum = 1.0)
WEIGHT_CYCLONE=0.25
WEIGHT_FLOOD=0.20
WEIGHT_SURGE=0.20
WEIGHT_INFRA=0.15
WEIGHT_ACCESS=0.10
WEIGHT_POPULATION=0.10

# Browser access. Set CORS_ORIGINS to the exact deployed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional frontend API URL at build time; defaults to same-origin /api.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
